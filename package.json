{
  "name": "fdd-chat-app",
  "version": "2.0.0",
  "private": true,
  "description": "Persona 5 inspired chat app built with React and Firebase",
  "repository": "git@github.com:fernandedios/fdd-chat-app.git",
  "author": "Fernan de Dios",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "dev": "vite",
    "dev:emulator": "vite --mode emulator",
    "emulators": "npx -y firebase-tools emulators:start --project demo-p5chat",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "check": "npm run lint && npm test && npm run build",
    "deploy": "npm run check && npx -y firebase-tools deploy --only hosting,database"
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
